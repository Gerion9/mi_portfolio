---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SplitWords from '../components/SplitWords.astro';
import { SITE_URL, fmt, formatMonthYear, localizePath, useCopy, type Lang } from '../i18n';
import { PROFILE, SOCIALS } from '../data/site';
import { RESUME } from '../data/resume';
import { getProjectBySlug, type Project } from '../lib/projects';
import { graph, personSchema } from '../lib/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = useCopy(lang);
const t = copy.resume;
const data = RESUME[lang];
const featured = copy.home.work.featured
  .slice(0, 3)
  .map((f) => getProjectBySlug(lang, f.slug))
  .filter(Boolean) as Project[];
const updated = formatMonthYear(PROFILE.resumeUpdated, lang);
const pageUrl = new URL(localizePath('/resume', lang), SITE_URL).toString();

const structuredData = graph({
  ...personSchema(lang),
  url: pageUrl,
  hasCredential: data.certifications.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
    credentialCategory: 'Certificate',
    recognizedBy: { '@type': 'Organization', name: c.issuer },
    ...(c.verifyUrl ? { url: c.verifyUrl } : {}),
  })),
});

const contact = [
  { icon: 'mail', label: PROFILE.email, href: `mailto:${PROFILE.email}`, external: false },
  { icon: 'phone', label: PROFILE.phone, href: PROFILE.phoneHref, external: false },
  { icon: 'linkedin', label: SOCIALS.linkedin.handle, href: SOCIALS.linkedin.href, external: true },
  { icon: 'github', label: SOCIALS.github.handle, href: SOCIALS.github.href, external: true },
  { icon: 'globe', label: 'gairoperalta.com', href: localizePath('/', lang), external: false },
];
---

<Layout title={t.metaTitle} description={t.metaDescription} structuredData={structuredData}>
  <section class="relative isolate overflow-hidden pb-12 pt-36 sm:pt-44" aria-labelledby="resume-title">
    <div class="resume-glow" aria-hidden="true"></div>
    <div class="container-site">
      <p class="eyebrow fade-load" style="--base: 0ms">{t.eyebrow}</p>
      <SplitWords as="h1" id="resume-title" text={t.title} mode="load" base={80} class="mt-6 block text-display-xl font-semibold text-fg" />
      <p class="lede fade-load mt-6 max-w-2xl" style="--base: 320ms">{t.intro}</p>
      <div class="fade-load mt-9 flex flex-wrap items-center gap-3" style="--base: 440ms">
        <a href={PROFILE.resumePdf} download="Gairo_Peralta_Resume.pdf" class="btn btn-primary">
          <Icon name="download" class="h-4 w-4" />
          {t.download}
        </a>
        <a href={PROFILE.resumePdf} target="_blank" rel="noopener" class="btn btn-secondary">
          {t.openPdf}
          <Icon name="arrow-up-right" class="h-4 w-4 opacity-70" />
        </a>
        <span class="ml-1 font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-fg-subtle">{fmt(t.updated, { date: updated })}</span>
      </div>
    </div>
  </section>

  <div class="container-site grid gap-10 pb-24 lg:grid-cols-12 lg:gap-14">
    <aside class="lg:col-span-4">
      <div class="surface space-y-8 p-6 sm:p-7 lg:sticky lg:top-28">
        <div class="flex items-center gap-4">
          <img
            src="/images/profile-192.webp"
            width="64"
            height="64"
            alt=""
            class="h-16 w-16 rounded-2xl border border-line-strong object-cover"
            loading="lazy"
            decoding="async"
          />
          <div>
            <p class="text-lg font-semibold tracking-[-0.02em] text-fg">Gairo Peralta</p>
            <p class="font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-fg-subtle">
              {lang === 'es' ? 'Ingeniero de IA/ML' : 'AI/ML Engineer'}
            </p>
          </div>
        </div>

        <ul class="space-y-1" role="list">
          {
            contact.map((c) => (
              <li>
                <a
                  href={c.href}
                  class="group -mx-2 flex items-center gap-3 rounded-xl px-2 py-2 text-[0.9375rem] text-fg-muted transition-colors hover:bg-fg/[0.05] hover:text-fg"
                  {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <Icon name={c.icon} class="h-4 w-4 shrink-0 opacity-70" />
                  <span class="truncate">{c.label}</span>
                  {c.external && <Icon name="arrow-up-right" class="ml-auto h-3.5 w-3.5 opacity-0 transition-opacity group-hover:opacity-60" />}
                </a>
              </li>
            ))
          }
        </ul>

        <div>
          <h2 class="resume-label">{t.sections.languages}</h2>
          <p class="mt-2 text-[0.9375rem] text-fg">{data.languages.map((l) => l.name).join(' · ')}</p>
        </div>

        <div>
          <h2 class="resume-label">{t.sections.education}</h2>
          <ul class="mt-3 space-y-4" role="list">
            {
              data.education.map((e) => (
                <li>
                  <p class="text-[0.9375rem] font-medium text-fg">{e.institution}</p>
                  <p class="mt-0.5 text-sm text-fg-muted">{e.degree}</p>
                  <p class="mt-1 flex flex-wrap items-center gap-2 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-fg-subtle">
                    {e.period}
                    {e.current && <span class="rounded-full border border-brand-lime/30 bg-brand-lime/10 px-2 py-0.5 text-[#86efac]">{t.current}</span>}
                  </p>
                  <p class="mt-1 text-sm text-fg-subtle">{e.note}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </aside>

    <div class="space-y-20 lg:col-span-8">
      <section aria-labelledby="summary-title">
        <h2 id="summary-title" class="resume-h">{t.sections.summary}</h2>
        <p class="reveal mt-5 text-xl leading-relaxed text-fg sm:text-[1.375rem]">{t.summary}</p>
      </section>

      <section aria-labelledby="experience-title">
        <h2 id="experience-title" class="resume-h">{t.sections.experience}</h2>
        <ol class="mt-6 divide-y divide-line border-y border-line" role="list">
          {
            data.experience.map((role, i) => (
              <li class="reveal grid gap-4 py-8 sm:grid-cols-[10rem_1fr] sm:gap-8" style={`--d: ${(i % 3) * 60}`}>
                <div>
                  <p class="font-mono text-xs uppercase tracking-[0.12em] text-fg-subtle tabular">{role.period}</p>
                  {role.current && (
                    <span class="mt-2 inline-flex items-center gap-1.5 font-mono text-[0.625rem] uppercase tracking-[0.12em] text-[#86efac]">
                      <span class="status-dot !h-1.5 !w-1.5" aria-hidden="true" />
                      {t.current}
                    </span>
                  )}
                </div>
                <div>
                  <h3 class="text-xl font-semibold tracking-[-0.02em] text-fg">{role.position}</h3>
                  <p class="mt-1 text-[0.9375rem] text-[#a5b4fc]">
                    {role.company} <span class="text-fg-subtle">· {role.location}</span>
                  </p>
                  <ul class="mt-4 space-y-2.5" role="list">
                    {role.bullets.map((b) => (
                      <li class="resume-bullet text-[0.9875rem] leading-relaxed text-fg-muted">{b}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="projects-title">
        <div class="flex items-end justify-between gap-4">
          <h2 id="projects-title" class="resume-h">{t.sections.projects}</h2>
          <a href={localizePath('/experience', lang)} class="link-underline text-sm text-fg-muted hover:text-fg">{copy.home.work.viewAll.replace('{count}', '').replace(/\s+/g, ' ').trim()}</a>
        </div>
        <ul class="mt-6 grid gap-3" role="list">
          {
            featured.map((p) => (
              <li class="reveal">
                <a
                  href={localizePath(`/experience/${p.slug}`, lang)}
                  class="surface spotlight group flex flex-col gap-3 p-6 transition-colors sm:flex-row sm:items-center sm:justify-between"
                >
                  <div class="min-w-0">
                    <p class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-fg-subtle">{p.company} · {p.year}</p>
                    <h3 class="mt-1.5 text-lg font-semibold tracking-[-0.02em] text-fg">{p.shortTitle}</h3>
                    <p class="mt-1 text-sm text-fg-muted">{p.subtitle}</p>
                  </div>
                  <div class="flex shrink-0 flex-wrap gap-2">
                    {p.metrics
                      .filter((m) => /\d/.test(m.value))
                      .slice(0, 2)
                      .map((m) => (
                        <span class="rounded-xl border border-line bg-fg/[0.03] px-3 py-1.5 text-sm font-semibold text-fg">{m.value}</span>
                      ))}
                    <Icon name="arrow-up-right" class="h-4 w-4 self-center text-fg-subtle transition-colors group-hover:text-fg" />
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="skills-title">
        <h2 id="skills-title" class="resume-h">{t.sections.skills}</h2>
        <dl class="mt-6 grid gap-6 sm:grid-cols-2">
          {
            data.skills.map((s) => (
              <div class="reveal">
                <dt class="text-[0.9375rem] font-medium text-fg">{s.group}</dt>
                <dd class="mt-3 flex flex-wrap gap-1.5">
                  {s.items.map((item) => (
                    <span class="tag">{item}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="certs-title">
        <h2 id="certs-title" class="resume-h">{t.sections.certifications}</h2>
        <ul class="mt-6 divide-y divide-line border-y border-line" role="list">
          {
            data.certifications.map((c) => (
              <li class="reveal flex flex-col gap-2 py-5 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="text-[0.9875rem] font-medium text-fg">{c.name}</p>
                  <p class="mt-0.5 text-sm text-fg-subtle">
                    {c.issuer} · {c.date}
                  </p>
                </div>
                {c.verifyUrl && (
                  <a href={c.verifyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm self-start sm:self-auto">
                    {t.verify}
                    <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="preview-title">
        <details class="resume-preview surface overflow-hidden" data-pdf-preview>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5">
            <span id="preview-title" class="flex items-center gap-3 text-[0.9375rem] font-medium text-fg">
              <Icon name="file-text" class="h-4 w-4 opacity-70" />
              {t.preview}
            </span>
            <Icon name="chevron-down" class="resume-preview__chev h-4 w-4 text-fg-subtle" />
          </summary>
          {/* An image of the page, not an <iframe>: phone browsers don't render
              PDFs inline. It loads only when the preview is opened. */}
          <div class="border-t border-line p-3 sm:p-4">
            <a href={PROFILE.resumePdf} target="_blank" rel="noopener" class="block overflow-hidden rounded-xl bg-white">
              <img
                src="/images/resume-preview-640.png"
                srcset="/images/resume-preview-640.png 640w, /images/resume-preview-1200.png 1200w"
                sizes="(min-width: 1024px) 45rem, calc(100vw - 4rem)"
                width="1200"
                height="1553"
                alt={lang === 'es' ? 'Vista previa del currículum de Gairo Peralta (abre el PDF)' : 'Preview of Gairo Peralta’s résumé (opens the PDF)'}
                loading="lazy"
                decoding="async"
                class="h-auto w-full"
              />
            </a>
            <div class="mt-3 flex flex-wrap gap-2">
              <a href={PROFILE.resumePdf} download="Gairo_Peralta_Resume.pdf" class="btn btn-primary btn-sm">
                <Icon name="download" class="h-4 w-4" />
                {t.download}
              </a>
              <a href={PROFILE.resumePdf} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                {t.openPdf}
              </a>
            </div>
          </div>
        </details>
      </section>
    </div>
  </div>
</Layout>

<style>
  .resume-glow {
    position: absolute;
    inset: -20% -10% auto 35%;
    height: 36rem;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(40% 50% at 65% 35%, rgb(var(--indigo) / 0.2), transparent 70%),
      radial-gradient(30% 40% at 85% 20%, rgb(var(--pink) / 0.1), transparent 70%);
  }

  .resume-label {
    font-family: theme('fontFamily.mono');
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(var(--fg-subtle));
  }

  .resume-h {
    font-family: theme('fontFamily.mono');
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgb(var(--fg-subtle));
  }

  .resume-bullet {
    position: relative;
    padding-left: 1.3rem;
  }

  .resume-bullet::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.55rem;
    height: 1px;
    background: linear-gradient(90deg, #a5b4fc, #f0abfc);
  }

  .resume-preview summary::-webkit-details-marker {
    display: none;
  }

  .resume-preview summary:focus-visible {
    outline-offset: -4px;
    border-radius: 1.5rem;
  }

  .resume-preview[open] .resume-preview__chev {
    transform: rotate(180deg);
  }

  .resume-preview__chev {
    transition: transform 0.35s var(--ease-out);
  }
</style>
