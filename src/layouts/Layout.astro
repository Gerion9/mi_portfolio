---
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	image?: string;
	noIndex?: boolean;
	structuredData?: Record<string, any>;
}

const {
	title,
	description = "Gairo Peralta - AI/ML Engineer specializing in LLM systems, GeoAI, and production ML pipelines.",
	image = "/images/profile-banner.jpg",
	noIndex = false,
	structuredData
} = Astro.props;

const faviconVersion = "2026-01-19";

// Base URL for canonical links and OG images
const baseUrl = "https://gairoperalta.com";
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const imageUrl = new URL(image.startsWith('http') ? image : image, baseUrl).toString();
---

<!DOCTYPE html>
<html lang="en" class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${faviconVersion}`} />
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Gairo Peralta (Gairo Yostin Peralta Alvarez)" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- Robots directive -->
		{noIndex ? (
			<meta name="robots" content="noindex, nofollow" />
		) : (
			<meta name="robots" content="index, follow" />
		)}
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="Gairo Peralta - AI/ML Engineer" />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={imageUrl} />
		
		<!-- Favicon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href={`/site.webmanifest?v=${faviconVersion}`}>
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5">
		<meta name="msapplication-TileColor" content="#603cba">
		<meta name="theme-color" content="#1a1a2e">
		
		<!-- Font Awesome -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
		
		<!-- Structured Data if provided -->
		{structuredData && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}
		
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-XXXXXXXXXX');
		</script>
		
		<!-- Preconnect to external domains -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preconnect" href="https://cdnjs.cloudflare.com">
		
		<!-- Custom styles -->
		<slot name="head" />
		<ViewTransitions />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style is:global>
  html, body {
    background-attachment: fixed;
    background-image: linear-gradient(135deg, #0a192f 0%, #1a0a1f 100%);
    overflow-x: hidden;
  }

  body {
    position: relative;
    display: flex;
    flex-direction: column;
    color: #e2e8f0;
    font-size: 16px;
    line-height: 1.5;
  }

  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 50% 50%, transparent 20%, #0a192f 20%, #0a192f 80%, transparent 80%, transparent);
    background-size: 50px 50px;
    opacity: 0.05;
    z-index: -1;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    body {
      font-size: 18px;
    }
    body::before {
      opacity: 0.1;
    }
  }

  .interactive-element {
    transition: all 0.3s ease;
  }

  .interactive-element:hover {
    transform: scale(1.05);
    box-shadow: 0 0 15px rgba(242, 73, 104, 0.5);
  }

  .timeline-indicator {
    position: fixed;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(to bottom, var(--color-primary), var(--color-accent));
    opacity: 0.3;
    z-index: 1000;
  }

  .timeline-indicator::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--scroll, 0%);
    background: var(--color-accent);
    transition: height 0.3s ease-out;
  }

  [data-date] {
    position: relative;
    transition: opacity 0.3s ease-out;
  }

  [data-date]::before {
    content: '';
    position: absolute;
    left: -20px;
    top: 50%;
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    border-radius: 50%;
    transform: translateY(-50%) scale(0);
    transition: transform 0.3s ease-out;
  }

  [data-date].active::before {
    transform: translateY(-50%) scale(1);
  }

  .date-markers {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .date-marker {
    position: absolute;
    left: 0;
    width: 100%;
    padding: 5px;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    font-size: 12px;
    text-align: center;
    transition: all 0.3s ease-out;
  }

  .date-marker.active {
    background: var(--color-accent);
    font-weight: bold;
  }

  .scrollable-content {
    height: calc(100vh - 310px);
    overflow-y: auto;
    padding-right: 60px;
    margin-bottom: 0px;
    mask-image: linear-gradient(to bottom, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 90%, transparent 100%);
  }

  .scrollable-content::-webkit-scrollbar {
    display: none;
  }

  .scrollable-content {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  html {
    scroll-behavior: smooth;
  }

  ::selection {
    background: rgba(242, 73, 104, 0.4);
    color: #f8fafc;
  }

  a, button, input, select, textarea {
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  a:active, button:active {
    transform: translateY(1px) scale(0.98);
  }

  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(242, 73, 104, 0.2);
  }

  .micro-link {
    position: relative;
  }

  .micro-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-primary));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
    opacity: 0.7;
  }

  .micro-link:hover::after,
  .micro-link:focus-visible::after {
    transform: scaleX(1);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transform: translateZ(0);
  }

  .social-link:hover {
    transform: translateY(-2px) scale(1.05);
    text-shadow: 0 0 18px rgba(242, 73, 104, 0.5);
  }

  .micro-cta {
    position: relative;
    overflow: hidden;
    transform: translateZ(0);
  }

  .micro-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.18) 45%, rgba(255, 255, 255, 0) 70%);
    transform: translateX(-120%);
    transition: transform 0.6s ease;
    opacity: 0.6;
  }

  .micro-cta:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 18px 38px rgba(15, 23, 42, 0.35), 0 0 18px rgba(99, 102, 241, 0.35);
  }

  .micro-cta:hover::after {
    transform: translateX(120%);
  }

  .card-hover {
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.35), 0 0 20px rgba(236, 72, 153, 0.2);
    border-color: rgba(236, 72, 153, 0.5);
  }

  html.js [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    filter: blur(6px);
    transition: opacity 0.8s ease, transform 0.8s ease, filter 0.8s ease;
  }

  html.js [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
	</head>
	<body class="flex flex-col min-h-screen">
		<header class="p-4 md:p-6">
			<nav>
				<ul class="flex flex-wrap justify-center space-x-4 md:space-x-8">
					<li><a href="/" class="nav-link micro-link text-indigo-300 hover:text-white transition-colors duration-300 text-sm md:text-lg font-semibold">Home</a></li>
					<li><a href="/about" class="nav-link micro-link text-indigo-300 hover:text-white transition-colors duration-300 text-sm md:text-lg font-semibold">About Me</a></li>
					<li><a href="/experience" class="nav-link micro-link text-indigo-300 hover:text-white transition-colors duration-300 text-sm md:text-lg font-semibold">Experience</a></li>
					<li><a href="/resume" class="nav-link micro-link text-indigo-300 hover:text-white transition-colors duration-300 text-sm md:text-lg font-semibold">Resume</a></li>
					<li><a href="/contact" class="nav-link micro-link text-indigo-300 hover:text-white transition-colors duration-300 text-sm md:text-lg font-semibold">Contact</a></li>
				</ul>
			</nav>
		</header>
		<main class="container mx-auto px-4 py-12 flex-grow max-w-4xl">
			<slot />
		</main>
		<footer class="py-8 text-center mt-auto">
			<div class="social-media space-x-6 mb-4">
				<a href="https://linkedin.com/in/gairoperalta" class="social-link text-indigo-300 hover:text-white transition-colors duration-300"><i class="fab fa-linkedin fa-2x"></i></a>
				<a href="https://github.com/Gerion9" class="social-link text-indigo-300 hover:text-white transition-colors duration-300"><i class="fab fa-github fa-2x"></i></a>
				<a href="https://www.facebook.com/gairo.yostin" class="social-link text-indigo-300 hover:text-white transition-colors duration-300"><i class="fab fa-facebook fa-2x"></i></a>
				<a href="https://www.instagram.com/gairo_peralta" class="social-link text-indigo-300 hover:text-white transition-colors duration-300"><i class="fab fa-instagram fa-2x"></i></a>
			</div>
			<p class="text-gray-400 text-sm">&copy; 2025 Gairo Peralta</p>
		</footer>
		<script is:inline>
			const setupReveal = () => {
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const revealElements = document.querySelectorAll('[data-reveal]:not([data-reveal-ready])');
				if (!revealElements.length) return;

				if (prefersReducedMotion) {
					revealElements.forEach(el => {
						el.setAttribute('data-reveal-ready', 'true');
						el.classList.add('is-visible');
					});
					return;
				}

				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				}, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });

				revealElements.forEach(el => {
					el.setAttribute('data-reveal-ready', 'true');
					observer.observe(el);
				});
			};

			const markJs = () => {
				document.documentElement.classList.add('js');
			};

			document.addEventListener('DOMContentLoaded', () => {
				markJs();
				setupReveal();
			});

			document.addEventListener('astro:page-load', () => {
				markJs();
				setupReveal();
			});
		</script>
	</body>
</html>
