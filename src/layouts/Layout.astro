---
import { ViewTransitions } from 'astro:transitions';
import Icon from '../components/Icon.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	noIndex?: boolean;
	structuredData?: Record<string, any>;
	isWide?: boolean;
}

const pathname = Astro.url.pathname;
const isEs = pathname.startsWith('/es/') || pathname === '/es';

const defaultDesc = isEs
	? "Gairo Peralta - Ingeniero de AI/ML especializado en sistemas LLM, GeoAI y pipelines de ML en producción."
	: "Gairo Peralta - AI/ML Engineer building LLM systems, GeoAI platforms, and production ML pipelines.";

const {
	title,
	description = defaultDesc,
	image = "/images/profile.webp",
	noIndex = false,
	structuredData,
	isWide = false
} = Astro.props;

// Base URL for canonical links and OG images
const baseUrl = "https://gairoperalta.com";
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const imageUrl = new URL(image.startsWith('http') ? image : image, baseUrl).toString();

const enPath = pathname.replace(/^\/es/, '') || '/';
const esPath = '/es' + (pathname.replace(/^\/es/, '') === '/' ? '' : pathname.replace(/^\/es/, ''));

const enUrl = new URL(enPath, baseUrl).toString();
const esUrl = new URL(esPath, baseUrl).toString();

const navItems = isEs ? [
	{ href: '/es', label: 'Inicio' },
	{ href: '/es/about', label: 'Sobre Mí' },
	{ href: '/es/experience', label: 'Experiencia' },
	{ href: '/es/resume', label: 'Currículum' },
	{ href: '/es/contact', label: 'Contacto' }
] : [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About Me' },
	{ href: '/experience', label: 'Experience' },
	{ href: '/resume', label: 'Resume' },
	{ href: '/contact', label: 'Contact' }
];

let toggleLangLink = isEs ? enPath : esPath;
---

<!DOCTYPE html>
<html lang={isEs ? "es" : "en"} class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Gairo Peralta (Gairo Yostin Peralta Alvarez)" />
		
		<!-- Canonical & Hreflang URLs -->
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="x-default" href={baseUrl + "/"} />
		
		<!-- Robots directive -->
		{noIndex ? (
			<meta name="robots" content="noindex, nofollow" />
		) : (
			<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		)}
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:locale" content={isEs ? "es_MX" : "en_US"} />
		<meta property="og:site_name" content={isEs ? "Gairo Peralta - Ingeniero de AI/ML" : "Gairo Peralta - AI/ML Engineer"} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={imageUrl} />
		
		<!-- Favicon & PWA Icons -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#4F46E5" />
		<meta name="msapplication-TileColor" content="#0a192f" />
		<meta name="theme-color" content="#0a192f" />
		
		<!-- Structured Data if provided -->
		{structuredData && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}
		
		<!-- Custom page head slots (preloads, fonts, etc.) -->
		<slot name="head" />
		<ViewTransitions />

<style is:global>
  html {
    background-image: linear-gradient(135deg, #0a192f 0%, #1a0a1f 100%);
    background-attachment: fixed;
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  body {
    background-color: transparent !important;
    position: relative;
    display: flex;
    flex-direction: column;
    color: #e2e8f0;
    font-size: 16px;
    line-height: 1.5;
    min-height: 100vh;
  }

  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 50% 50%, transparent 20%, #0a192f 20%, #0a192f 80%, transparent 80%, transparent);
    background-size: 50px 50px;
    opacity: 0.06;
    z-index: -1;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    body {
      font-size: 18px;
    }
    body::before {
      opacity: 0.1;
    }
  }

  .interactive-element {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .interactive-element:hover {
    transform: scale(1.05);
    box-shadow: 0 0 15px rgba(242, 73, 104, 0.5);
  }

  ::selection {
    background: rgba(242, 73, 104, 0.4);
    color: #f8fafc;
  }

  a, button, input, select, textarea {
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  a:active, button:active {
    transform: translateY(1px) scale(0.98);
  }

  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 2px solid var(--color-accent, #F24968);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(242, 73, 104, 0.2);
  }

  .micro-link {
    position: relative;
  }

  .micro-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, #F24968, #4F46E5);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
    opacity: 0.7;
  }

  .micro-link:hover::after,
  .micro-link:focus-visible::after {
    transform: scaleX(1);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: 0.5rem;
    transform: translateZ(0);
  }

  .social-link:hover {
    transform: translateY(-2px) scale(1.08);
    color: #ffffff;
  }

  .micro-cta {
    position: relative;
    overflow: hidden;
    transform: translateZ(0);
  }

  .micro-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.18) 45%, rgba(255, 255, 255, 0) 70%);
    transform: translateX(-120%);
    transition: transform 0.6s ease;
    opacity: 0.6;
  }

  .micro-cta:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 18px 38px rgba(15, 23, 42, 0.35), 0 0 18px rgba(99, 102, 241, 0.35);
  }

  .micro-cta:hover::after {
    transform: translateX(120%);
  }

  /* Global Mouse-following Background Aura */
  #global-pointer-aura {
    pointer-events: none;
    position: fixed;
    inset: 0;
    z-index: -2;
    opacity: 0;
    background: radial-gradient(
      600px circle at var(--global-mouse-x, 0px) var(--global-mouse-y, 0px),
      rgba(99, 102, 241, 0.18) 0%,
      rgba(168, 85, 247, 0.1) 35%,
      rgba(242, 73, 104, 0.04) 70%,
      transparent 100%
    );
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: background;
  }

  .card-hover {
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.45), 
                0 0 25px rgba(242, 73, 104, 0.15), 
                0 0 40px rgba(99, 102, 241, 0.1);
    border-color: rgba(242, 73, 104, 0.4) !important;
  }

  /* Spotlight glow overlay inside the box */
  .card-hover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      300px circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
      rgba(99, 102, 241, 0.06) 0%,
      rgba(242, 73, 104, 0.02) 50%,
      transparent 80%
    );
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .card-hover:hover::after,
  .card-hover.touch-active::after {
    opacity: 1;
  }

  .card-hover > * {
    position: relative;
    z-index: 10;
  }

  html.js [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    filter: blur(4px);
    transition: opacity 0.6s ease, transform 0.6s ease, filter 0.6s ease;
  }

  html.js [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    html.js [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>
	</head>
	<body class="flex flex-col min-h-screen">
		<div id="global-pointer-aura" aria-hidden="true"></div>
		<header class="p-4 md:p-6">
			<nav aria-label={isEs ? "Navegación principal" : "Main Navigation"}>
				<ul class="flex flex-wrap justify-center gap-3 sm:gap-6 md:gap-8 items-center">
					{navItems.map(item => (
						<li>
							<a href={item.href} class="nav-link micro-link text-indigo-200 hover:text-white transition-colors duration-300 text-sm md:text-lg font-semibold py-1 px-2 inline-block">
								{item.label}
							</a>
						</li>
					))}
					<li>
						<a href={toggleLangLink} class="nav-link micro-link text-indigo-200 hover:text-white transition-colors duration-300 text-sm md:text-lg font-semibold flex items-center gap-1.5 py-1 px-2" aria-label={isEs ? "EN - Switch language to English" : "ES - Cambiar idioma a Español"}>
							<Icon name="globe" class="w-4 h-4 text-indigo-300" />
							<span>{isEs ? 'EN' : 'ES'}</span>
						</a>
					</li>
				</ul>
			</nav>
		</header>
		<main class={`container mx-auto px-4 py-8 md:py-12 flex-grow ${isWide ? 'max-w-7xl lg:px-8 xl:max-w-[1400px]' : 'max-w-4xl'}`}>
			<slot />
		</main>
		<footer class="py-8 text-center mt-auto" role="contentinfo">
			<div class="social-media flex justify-center items-center gap-4 sm:gap-6 mb-4">
				<a href="https://linkedin.com/in/gairoperalta" target="_blank" rel="noopener noreferrer" class="social-link text-indigo-300 hover:text-pink-400 transition-colors duration-300 p-2" aria-label="LinkedIn profile of Gairo Peralta">
					<Icon name="linkedin" class="w-6 h-6 sm:w-7 sm:h-7" />
				</a>
				<a href="https://github.com/Gerion9" target="_blank" rel="noopener noreferrer" class="social-link text-indigo-300 hover:text-pink-400 transition-colors duration-300 p-2" aria-label="GitHub profile of Gairo Peralta">
					<Icon name="github" class="w-6 h-6 sm:w-7 sm:h-7" />
				</a>
				<a href="https://www.facebook.com/gairo.yostin" target="_blank" rel="noopener noreferrer" class="social-link text-indigo-300 hover:text-pink-400 transition-colors duration-300 p-2" aria-label="Facebook profile of Gairo Peralta">
					<Icon name="facebook" class="w-6 h-6 sm:w-7 sm:h-7" />
				</a>
				<a href="https://www.instagram.com/gairo_peralta" target="_blank" rel="noopener noreferrer" class="social-link text-indigo-300 hover:text-pink-400 transition-colors duration-300 p-2" aria-label="Instagram profile of Gairo Peralta">
					<Icon name="instagram" class="w-6 h-6 sm:w-7 sm:h-7" />
				</a>
			</div>
			<p class="text-slate-300 text-xs sm:text-sm font-medium">&copy; {new Date().getFullYear()} Gairo Peralta. All rights reserved.</p>
		</footer>

		<script is:inline>
			const setupReveal = () => {
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const revealElements = document.querySelectorAll('[data-reveal]:not([data-reveal-ready])');
				if (!revealElements.length) return;

				if (prefersReducedMotion) {
					revealElements.forEach(el => {
						el.setAttribute('data-reveal-ready', 'true');
						el.classList.add('is-visible');
					});
					return;
				}

				if ('IntersectionObserver' in window) {
					const observer = new IntersectionObserver((entries) => {
						entries.forEach(entry => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					}, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });

					revealElements.forEach(el => {
						el.setAttribute('data-reveal-ready', 'true');
						observer.observe(el);
					});
				} else {
					revealElements.forEach(el => {
						el.classList.add('is-visible');
					});
				}
			};

			const setupGlobalAura = () => {
				const aura = document.getElementById('global-pointer-aura');
				if (!aura || window.globalAuraInitialized) return;
				window.globalAuraInitialized = true;

				if (window.matchMedia('(pointer: coarse)').matches) return;

				let rafId = null;
				let mouseX = 0;
				let mouseY = 0;

				const updateAura = () => {
					aura.style.setProperty('--global-mouse-x', `${mouseX}px`);
					aura.style.setProperty('--global-mouse-y', `${mouseY}px`);
					rafId = null;
				};

				window.addEventListener('mousemove', (e) => {
					mouseX = e.clientX;
					mouseY = e.clientY;
					aura.style.opacity = '1';
					if (!rafId) {
						rafId = requestAnimationFrame(updateAura);
					}
				}, { passive: true });

				document.addEventListener('mouseleave', () => {
					aura.style.opacity = '0';
				}, { passive: true });
			};

			const setup3DTilt = () => {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				const cards = document.querySelectorAll('.card-hover');

				cards.forEach(card => {
					if (card.dataset.tiltInitialized === 'true') return;
					card.dataset.tiltInitialized = 'true';

					card.addEventListener('mousemove', (e) => {
						const rect = card.getBoundingClientRect();
						const x = e.clientX - rect.left;
						const y = e.clientY - rect.top;

						card.style.setProperty('--mouse-x', `${x}px`);
						card.style.setProperty('--mouse-y', `${y}px`);
					}, { passive: true });

					card.addEventListener('mouseleave', () => {
						card.style.setProperty('--mouse-x', `0px`);
						card.style.setProperty('--mouse-y', `0px`);
					}, { passive: true });
				});
			};

			const initApp = () => {
				document.documentElement.classList.add('js');
				setupReveal();
				setupGlobalAura();
				setup3DTilt();
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initApp);
			} else {
				initApp();
			}
			document.addEventListener('astro:page-load', initApp);
		</script>
	</body>
</html>
