---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import serifItalicLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_URL, alternatePath, getLangFromUrl, plain, useCopy } from '../i18n';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Describes `image` for og:image:alt (defaults to the site card's text). */
  imageAlt?: string;
  noIndex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Hide the footer wordmark spacing on full-bleed pages, etc. */
  bodyClass?: string;
  /** False for pages that exist in one language only (legal pages, 404). */
  translated?: boolean;
}

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useCopy(lang);

const {
  title,
  description = lang === 'es'
    ? 'Gairo Peralta, ingeniero de IA/ML: sistemas con LLM, plataformas GeoAI y pipelines de ML en producción.'
    : 'Gairo Peralta, AI/ML engineer building LLM systems, GeoAI platforms and production ML pipelines.',
  image = lang === 'es' ? '/og/og-es.png' : '/og/og-en.png',
  imageAlt = lang === 'es'
    ? 'Gairo Peralta, ingeniero de IA/ML: construyo IA que lee el territorio y el lenguaje.'
    : 'Gairo Peralta, AI/ML engineer: I build AI that reads places and language.',
  noIndex = false,
  structuredData,
  bodyClass,
  translated = true,
} = Astro.props;

const pageTitle = plain(title);
const canonical = new URL(alternatePath(pathname, lang), SITE_URL).toString();
const enUrl = new URL(alternatePath(pathname, 'en'), SITE_URL).toString();
const esUrl = new URL(alternatePath(pathname, 'es'), SITE_URL).toString();
const imageUrl = new URL(image, SITE_URL).toString();
const jsonLd = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];

// Instant navigations in Chromium: prerender same-site pages on hover/pointerdown.
const speculationRules = {
  prerender: [
    {
      where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/documents/*' } }] },
      eagerness: 'moderate',
    },
  ],
};
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gairo Peralta (Gairo Yostin Peralta Alvarez)" />
    {!noIndex && <link rel="canonical" href={canonical} />}
    {
      translated && !noIndex && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="es" href={esUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }
    {
      noIndex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      )
    }

    <meta name="theme-color" content="#07070c" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_MX'} />
    <meta property="og:site_name" content="Gairo Peralta" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- All three faces appear above the fold (name, serif accents, mono labels):
         preloading them avoids the late swap that reflowed the hero (CLS). -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          // Fail-safe: never leave content hidden if the interaction script fails.
          setTimeout(function () {
            if (!window.__revealReady) d.classList.add('reveal-all');
          }, 3000);
        }
      })();
    </script>
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />

    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <slot name="head" />
  </head>
  <body class:list={['bg-ink text-fg', bodyClass]}>
    <a
      href="#main"
      class="sr-only-focusable fixed left-4 top-4 z-[100] rounded-full bg-fg px-5 py-3 text-sm font-medium text-ink"
      >{t.nav.skip}</a
    >

    <!-- Shared SVG paint servers -->
    <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="gp-mark" x1="4" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#a5b4fc"></stop>
          <stop offset="0.5" stop-color="#c084fc"></stop>
          <stop offset="1" stop-color="#fb7185"></stop>
        </linearGradient>
      </defs>
    </svg>

    <SiteHeader lang={lang} pathname={pathname} translated={translated} />

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <SiteFooter lang={lang} pathname={pathname} translated={translated} />

    <div class="grain" aria-hidden="true"></div>

    <script>
      import { initInteractions } from '../scripts/interactions';
      initInteractions();
    </script>
  </body>
</html>
