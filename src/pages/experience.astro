function getCategoryIcon(category: string) {
    const icons = {
    "Data Analysis and Visualization": "📊",
    "Web Development and Technologies": "💻",
    "Databases and Data Management": "🗄️",
    "Optimization and Performance": "⚡",
    "Design and User Experience": "🎨",
    "Artificial Intelligence and Machine Learning": "🤖",
    "Project Management and Methodologies": "📅",
    "Specific Analyses": "🔍",
    "Tools and Platforms": "🛠️"
  };
  return icons[category] || "📌";
}

const tagCategories = {
  "Data Analysis and Visualization": ["Data Analysis", "Data Visualization", "Business Intelligence", "Geospatial Analysis", "GeoAI"],
  "Web Development and Technologies": ["Web Development", "React", "FastAPI", "Astro", "Tailwind CSS", "Node.js", "Vite"],
  "Databases and Data Management": ["MongoDB", "SQL", "ETL", "Database Management", "Data Processing", "Data Migration", "Vector Database", "Pinecone", "Neo4j", "Knowledge Graph"],
  "Optimization and Performance": ["Performance Optimization", "Automation", "Real-time Systems", "Latency Optimization"],
  "Design and User Experience": ["UI/UX Design", "Responsive Design", "Accessibility", "Animation"],
  "Artificial Intelligence and Machine Learning": ["Machine Learning", "Deep Learning", "OpenAI", "Time Series Analysis", "LLM", "RAG", "Agents", "NLP", "Embeddings", "Multimodal AI", "Medical AI"],
  "Project Management and Methodologies": ["Project Management", "Git", "Version Control", "Documentation"],
  "Specific Analyses": ["Financial Analysis", "Survey Analysis", "Market Analysis", "User Engagement", "Customer Behavior"],
  "Tools and Platforms": ["Python", "JavaScript", "ArcGIS", "SaaS Platform", "Pandas", "Numpy", "TensorFlow", "PyTorch", "Mapbox GL", "Turf.js", "Google Cloud", "Speechmatics", "FAISS", "RBAC"]
};

// Sort projects by date (most recent to oldest)
const projects = [...unsortedProjects].sort((a, b) => {
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});

// Structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Gairo Y. Peralta",
    "jobTitle": "AI/ML Engineer",
    "knowsAbout": Array.from(new Set(projects.flatMap(p => p.tags || [])))
  },
  "about": {
    "@type": "ItemList",
    "itemListElement": projects.map((project, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Project",
        "name": project.title,
        "description": project.impact
      }
    }))
  }
};
---

<Layout title="Experience & Projects - Gairo Peralta" description="Explore AI/ML, LLM, and GeoAI projects showcasing production systems, analytics, and scalable data pipelines.">
  <div class="fade-container px-2 sm:px-4" data-experience-page>
    <div class="scrollable-content custom-scrollbar">
      <h1 class="text-3xl sm:text-5xl font-bold mb-4 sm:mb-8 text-center text-indigo-300">Experience & Projects</h1>
      
      <!-- Stats Overview -->
      <div class="bg-gray-800/50 p-4 sm:p-6 rounded-lg mb-6 sm:mb-10 card-hover" data-reveal>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 text-center">
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-pink-500">{projects.length}</div>
            <div class="text-xs sm:text-sm text-gray-400">Projects</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-pink-500">
              {new Set(projects.map(p => p.company)).size}
            </div>
            <div class="text-xs sm:text-sm text-gray-400">Companies</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-pink-500">
              {new Set(projects.flatMap(p => p.tags || [])).size}
            </div>
            <div class="text-xs sm:text-sm text-gray-400">Skills</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-pink-500">
              {Math.max(...projects.map(p => new Date(p.date).getFullYear())) - Math.min(...projects.map(p => new Date(p.date).getFullYear())) + 1}
            </div>
            <div class="text-xs sm:text-sm text-gray-400">Years</div>
          </div>
        </div>
      </div>
      
      <!-- Mobile filter toggle -->
      <div class="lg:hidden mb-4" data-reveal>
        <button id="mobile-filter-toggle" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 px-4 rounded-lg text-sm font-medium transition duration-300 flex items-center justify-center touch-manipulation micro-cta">
          <span id="filter-toggle-text">Show Filters</span>
          <i class="fas fa-filter ml-2"></i>
        </button>
      </div>
      
      <!-- Filters and Content Layout -->
      <div class="flex flex-col lg:flex-row gap-4 sm:gap-8 mb-10">
        <!-- Main Content -->
        <div class="w-full lg:w-3/4 order-2 lg:order-1">
          <!-- Projects Timeline -->
          <div class="relative">
            <div class="absolute left-0 w-1 h-full bg-indigo-600/30 rounded"></div>
            
            <div class="space-y-8 sm:space-y-16">
              {projects.map((project) => (
                <div class="pl-6 sm:pl-8 relative project" data-date={project.date} data-tags={project.tags?.join(',')}>
                  <!-- Timeline dot -->
                  <div class="absolute left-0 w-3 sm:w-4 h-3 sm:h-4 bg-pink-500 rounded-full transform -translate-x-1.5 mt-2"></div>
                  
                  <!-- Date badge -->
                  <div class="absolute left-6 sm:left-8 -ml-8 -mt-8 sm:-mt-10">
                    <span class="bg-indigo-600/80 text-white text-xs py-1 px-2 rounded">
                      {new Date(project.date).getFullYear()}
                    </span>
                  </div>
                  
                  <div class="bg-gray-800 p-4 sm:p-8 rounded-lg shadow-lg border border-gray-700/60 project-card card-hover">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 sm:gap-4 mb-4 sm:mb-6">
                      <div>
                        <h2 class="text-xl sm:text-3xl font-bold mb-1 sm:mb-2 text-pink-500">{project.title}</h2>
                        <p class="text-base sm:text-xl text-gray-400">
                          {project.company}
                        </p>
                      </div>
                      
                      <!-- Impact metrics if available -->
                      {project.impact && (
                        <div class="flex flex-wrap gap-2">
                          {project.impact.map(metric => (
                            <div class="bg-gray-700/50 px-2 sm:px-3 py-1 sm:py-2 rounded-lg flex flex-col items-center">
                              <span class="text-base sm:text-lg font-bold text-indigo-300">
                                {metric.includes(':') ? metric.split(':')[1].trim() : metric}
                              </span>
                              <span class="text-xs text-gray-300">
                                {metric.includes(':') ? metric.split(':')[0].trim() : ''}
                              </span>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                    
                    <div class="mb-4 sm:mb-6 flex flex-wrap gap-1 sm:gap-2">
                      {project.tags && project.tags.map((tag) => (
                        <span class="bg-indigo-600/80 text-white px-2 py-1 rounded-full text-xs">{tag}</span>
                      ))}
                    </div>
                    
                    <div class="space-y-2 sm:space-y-4">
                      {typeof project.description === 'string' ? (
                        <p class="text-sm sm:text-base text-gray-300">{project.description}</p>
                      ) : (
                        (() => {
                          if (project.description && Array.isArray(project.description)) {
                            const descArr: string[] = project.description as string[];
                            return descArr.map((item: string) => (
                              <div class="flex items-start">
                                <span class="text-indigo-300 mr-2">•</span>
                                <p class="text-sm sm:text-base text-gray-300">{item}</p>
                              </div>
                            ));
                          }
                          return null;
                        })()
                      )}
                    </div>
                    
                    <div class="mt-4 sm:mt-8 p-3 sm:p-4 bg-indigo-900/30 rounded-lg">
                      <h3 class="text-base sm:text-lg font-semibold text-indigo-300 mb-2">Key Achievements</h3>
                      <ul class="space-y-1 sm:space-y-2">
                        {project.impacts && project.impacts.map((impact) => (
                          <li class="flex items-start">
                            <span class="text-pink-500 mr-2">→</span>
                            <p class="text-xs sm:text-sm text-gray-300">{impact}</p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        
        <!-- Filters sidebar -->
        <div id="filters-container" class="w-full lg:w-1/4 lg:sticky lg:top-8 self-start order-1 lg:order-2 hidden lg:block" data-reveal>
          <div class="bg-gray-800/80 p-4 rounded-lg shadow-lg card-hover">
            <h2 class="text-xl font-bold mb-4 text-pink-500 flex justify-between items-center">
              <span>Filter Projects</span>
              <button id="mobile-filter-close" class="lg:hidden text-gray-400 hover:text-white">
                <i class="fas fa-times"></i>
              </button>
            </h2>
            <div class="space-y-3 sm:space-y-4 max-h-[60vh] overflow-y-auto pb-2">
    {Object.entries(tagCategories).map(([category, tags]) => (
                <div class="bg-gray-900/50 p-3 rounded-lg">
                  <button class="category-filter w-full text-left font-semibold text-indigo-300 hover:text-indigo-100 transition-colors duration-300 flex items-center touch-manipulation" data-selected="false">
          <span class="mr-2">{getCategoryIcon(category)}</span>
          <span class="text-sm">{category}</span>
                    <span class="ml-auto text-xs bg-indigo-600/60 px-2 py-0.5 rounded-full">
                      {tags.filter(tag => projects.some(p => p.tags?.includes(tag))).length}
                    </span>
        </button>
                  <div class="mt-2 space-y-1 hidden">
          {tags.map((tag) => (
                      <button class="tag-filter w-full text-left text-white text-xs py-1 px-2 rounded transition duration-300 hover:bg-gray-700 flex justify-between items-center touch-manipulation" data-selected="false" data-tag={tag}>
                        <span>{tag}</span>
                        <span class="text-xs bg-gray-700/60 px-1.5 rounded-full">
                          {projects.filter(p => p.tags?.includes(tag)).length}
                        </span>
            </button>
          ))}
        </div>
      </div>
    ))}
</div>

            <div class="mt-4 pt-4 border-t border-gray-700">
              <button id="clear-filters" class="w-full bg-pink-500 hover:bg-pink-600 text-white py-2 rounded text-sm font-medium transition duration-300 touch-manipulation micro-cta">
                Clear All Filters
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Add structured data for SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
</Layout>
<script>
  const initExperience = () => {
    const root = document.querySelector('[data-experience-page]') as HTMLElement | null;
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const win = window as Window & { __experienceResizeHandler?: () => void };

    document.documentElement.classList.remove('no-js');
    document.documentElement.classList.add('js');

    const categoryButtons = root.querySelectorAll('.category-filter');
    const tagButtons = root.querySelectorAll('.tag-filter');
    const projects = root.querySelectorAll('.project');
    const clearFiltersButton = root.querySelector('#clear-filters');
    const mobileFilterToggle = root.querySelector('#mobile-filter-toggle');
    const filtersContainer = root.querySelector('#filters-container');
    const mobileFilterClose = root.querySelector('#mobile-filter-close');
    const filterToggleText = root.querySelector('#filter-toggle-text');

    const selectedTags = new Set<string>();
    let filtersVisible = false;

    // Toggle mobile filters
    mobileFilterToggle?.addEventListener('click', () => {
      filtersVisible = !filtersVisible;
      if (filtersContainer) {
        filtersContainer.classList.toggle('hidden', !filtersVisible);
        if (filterToggleText) {
          filterToggleText.textContent = filtersVisible ? 'Hide Filters' : 'Show Filters';
        }
      }
    });

    // Close mobile filters
    mobileFilterClose?.addEventListener('click', () => {
      filtersVisible = false;
      if (filtersContainer) {
        filtersContainer.classList.add('hidden');
        if (filterToggleText) {
          filterToggleText.textContent = 'Show Filters';
        }
      }
    });

    categoryButtons.forEach(button => {
      button.addEventListener('click', () => {
        const isSelected = button.getAttribute('data-selected') === 'true';
        const tagContainer = button.nextElementSibling;
        
        if (isSelected) {
          button.setAttribute('data-selected', 'false');
          button.classList.remove('text-indigo-100');
          button.classList.add('text-indigo-300');
          tagContainer.classList.add('hidden');
        } else {
          button.setAttribute('data-selected', 'true');
          button.classList.remove('text-indigo-300');
          button.classList.add('text-indigo-100');
          tagContainer.classList.remove('hidden');
        }
      });
    });

    tagButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tag = button.getAttribute('data-tag') || button.textContent?.trim() || '';
        const isSelected = button.getAttribute('data-selected') === 'true';
        
        if (isSelected) {
          selectedTags.delete(tag);
          button.setAttribute('data-selected', 'false');
          button.classList.remove('bg-indigo-600');
          button.classList.add('bg-gray-800');
        } else {
          selectedTags.add(tag);
          button.setAttribute('data-selected', 'true');
          button.classList.remove('bg-gray-800');
          button.classList.add('bg-indigo-600');
        }
        
        filterProjects();
      });
    });

    clearFiltersButton?.addEventListener('click', () => {
      selectedTags.clear();
      
      tagButtons.forEach(button => {
        button.setAttribute('data-selected', 'false');
        button.classList.remove('bg-indigo-600');
        button.classList.add('bg-gray-800');
      });
      
      filterProjects();
      
      // On mobile, close the filter panel after clearing
      if (window.innerWidth < 1024) {
        filtersVisible = false;
        if (filtersContainer) {
          filtersContainer.classList.add('hidden');
          if (filterToggleText) {
            filterToggleText.textContent = 'Show Filters';
          }
        }
      }
    });

    function filterProjects() {
      projects.forEach(project => {
        if (project instanceof HTMLElement) {
          const projectTags = project.dataset.tags?.split(',') || [];
          const shouldShow = selectedTags.size === 0 || Array.from(selectedTags).some(tag => typeof tag === 'string' && projectTags.includes(tag));
          project.style.display = shouldShow ? 'block' : 'none';
        }
      });
    }
    
    // Add animation to timeline elements on scroll
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      projects.forEach(project => {
        if (project instanceof HTMLElement) {
          project.style.opacity = '1';
        }
      });
    } else {
      projects.forEach(project => {
        if (project instanceof HTMLElement) {
          project.style.opacity = '0';
        }
      });
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-fadeIn');
            if (entry.target instanceof HTMLElement) {
              entry.target.style.opacity = '1';
            }
          }
        });
      }, { threshold: 0.1 });
      
      projects.forEach(project => observer.observe(project));
    }
    
    // Adjust layout for screen size changes
    if (win.__experienceResizeHandler) {
      window.removeEventListener('resize', win.__experienceResizeHandler);
    }
    win.__experienceResizeHandler = () => {
      if (window.innerWidth >= 1024 && filtersContainer) {
        filtersContainer.classList.remove('hidden');
      } else if (window.innerWidth < 1024 && !filtersVisible && filtersContainer) {
        filtersContainer.classList.add('hidden');
      }
    };
    window.addEventListener('resize', win.__experienceResizeHandler);
  };

  document.addEventListener('DOMContentLoaded', initExperience);
  document.addEventListener('astro:page-load', initExperience);
</script>

<style>
  .animate-fadeIn {
    animation: fadeIn 0.8s ease forwards;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .project {
    opacity: 1; /* Changed from 0 to 1 to ensure projects are visible by default */
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  
  /* Add class for when JS fails */
  .no-js .project {
    opacity: 1;
  }
  
  /* Custom scrollbar styling */
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: rgba(236, 72, 153, 0.5) rgba(17, 24, 39, 0.5);
  }
  
  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
  }
  
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(17, 24, 39, 0.5);
    border-radius: 10px;
  }
  
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: linear-gradient(to bottom, rgba(236, 72, 153, 0.7), rgba(79, 70, 229, 0.7));
    border-radius: 10px;
    border: 2px solid rgba(17, 24, 39, 0.5);
  }
  
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(to bottom, rgba(236, 72, 153, 0.9), rgba(79, 70, 229, 0.9));
  }
  
  /* Improved touch target for mobile */
  .touch-manipulation {
    touch-action: manipulation;
  }
  
  /* Limit filter height on small screens */
  @media (max-width: 640px) {
    #filters-container .space-y-4 {
      max-height: 70vh;
      overflow-y: auto;
    }
  }

  .project-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(236, 72, 153, 0.5);
    box-shadow: 0 18px 36px rgba(15, 23, 42, 0.35), 0 0 18px rgba(236, 72, 153, 0.25);
  }

  .category-filter,
  .tag-filter {
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .category-filter[data-selected="true"] {
    background: rgba(79, 70, 229, 0.18);
    border-radius: 8px;
    padding: 0.35rem 0.5rem;
  }

  .tag-filter[data-selected="true"] {
    background: rgba(79, 70, 229, 0.6);
    box-shadow: 0 10px 18px rgba(15, 23, 42, 0.3);
    transform: translateY(-1px);
  }

  .tag-filter:hover {
    transform: translateY(-1px);
  }
</style>

