];

// Define education for education section
const education = [
  {
    institution: "Tecnologico de Monterrey",
    degree: "Master's Degree",
    field: "Applied Artificial Intelligence (MNA)",
    years: "2025-2026",
    description: "Currently pursuing advanced studies in cutting-edge AI technologies, specializing in machine learning applications for business intelligence and predictive analytics.",
    logo: "/images/tec-logo.png",
    inProgress: true
  },
  {
    institution: "University of California, Berkeley",
    degree: "Bachelor's Degree",
    field: "Data Science",
    years: "2018-2022",
    description: "Focusing on machine learning, statistical analysis, and data visualization. Completed capstone project on predictive modeling for sustainable urban development.",
