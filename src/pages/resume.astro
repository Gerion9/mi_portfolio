  },
  {
    position: "Data Scientist",
    company: "BlackPrint Technologies",
    location: "Berkeley, CA",
    period: "2022 - 2023",
    responsibilities: [
      "Delivered property analytics with Google Maps geocoding (92% accuracy)",
      "Built pandas/SQL ETL pipelines ensuring 99.9% deliverable accuracy",
      "Produced geospatial insights for property intelligence reporting"
