---
import CaseStudyPage from '../../views/CaseStudyPage.astro';
import { getProjects } from '../../lib/projects';

export function getStaticPaths() {
  return getProjects('en').map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---

<CaseStudyPage lang="en" slug={slug as string} />
