  <!-- Add structured data for SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

  <script is:inline>
    const initTimeline = () => {
      const timeline = document.querySelector('[data-timeline]');
      if (!timeline || timeline.dataset.initialized === 'true') return;
      timeline.dataset.initialized = 'true';

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = timeline.querySelectorAll('[data-timeline-item]');

      const updateProgress = () => {
        const rect = timeline.getBoundingClientRect();
        const scrollY = window.scrollY || window.pageYOffset;
        const offsetTop = rect.top + scrollY;
        const start = offsetTop - window.innerHeight * 0.3;
        const end = offsetTop + rect.height - window.innerHeight * 0.4;
        const progress = (scrollY - start) / (end - start);
        const clamped = Math.max(0, Math.min(1, progress));
        timeline.style.setProperty('--timeline-progress', `${clamped * 100}%`);
      };

      if (prefersReducedMotion) {
        items.forEach(item => item.classList.add('is-active'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            entry.target.classList.toggle('is-active', entry.isIntersecting);
          });
        }, { rootMargin: '-20% 0px -60% 0px', threshold: 0.2 });

        items.forEach(item => observer.observe(item));
      }

      if (window.__timelineScrollHandler) {
        window.removeEventListener('scroll', window.__timelineScrollHandler);
        window.removeEventListener('resize', window.__timelineScrollHandler);
      }

      window.__timelineScrollHandler = updateProgress;
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
    };

    document.addEventListener('DOMContentLoaded', initTimeline);
    document.addEventListener('astro:page-load', initTimeline);
  </script>
  
  <style>
    /* Improved touch target for mobile */
    .touch-manipulation {
      touch-action: manipulation;
    }
    
    /* Responsive typography adjustments */
    @media (max-width: 640px) {
      .prose p {
        margin-top: 0.75rem;
        margin-bottom: 0.75rem;
      }
    }

    .timeline-wrap {
      position: relative;
      --timeline-progress: 0%;
    }

    .timeline-track,
    .timeline-progress {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 2px;
      transform: translateX(-50%);
      border-radius: 999px;
    }

    .timeline-track {
      background: linear-gradient(180deg, rgba(148, 163, 184, 0.2), rgba(148, 163, 184, 0.05));
    }

    .timeline-progress {
      bottom: auto;
      height: var(--timeline-progress);
      background: linear-gradient(180deg, rgba(236, 72, 153, 0.9), rgba(79, 70, 229, 0.9));
      box-shadow: 0 0 18px rgba(236, 72, 153, 0.45);
    }

    .timeline-entry {
      position: relative;
    }

    .timeline-dot {
      position: absolute;
      left: 50%;
      top: 22px;
      width: 12px;
      height: 12px;
      border-radius: 999px;
      background: #f24968;
      box-shadow: 0 0 0 4px rgba(242, 73, 104, 0.18);
      transform: translateX(-50%) scale(1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      z-index: 2;
    }

    .timeline-entry.is-active .timeline-dot {
      transform: translateX(-50%) scale(1.35);
      box-shadow: 0 0 0 6px rgba(242, 73, 104, 0.25), 0 0 20px rgba(242, 73, 104, 0.6);
    }

    .timeline-card {
      background: rgba(31, 41, 55, 0.78);
      border: 1px solid rgba(99, 102, 241, 0.25);
      border-radius: 16px;
      padding: 1.25rem 1.5rem;
      backdrop-filter: blur(10px);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .timeline-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.35), 0 0 22px rgba(236, 72, 153, 0.2);
      border-color: rgba(236, 72, 153, 0.5);
    }

    .timeline-entry.is-active .timeline-card {
      border-color: rgba(236, 72, 153, 0.45);
      box-shadow: 0 18px 36px rgba(15, 23, 42, 0.35), 0 0 20px rgba(99, 70, 229, 0.2);
    }

    .timeline-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .timeline-year {
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #c7d2fe;
      padding: 2px 8px;
      border-radius: 999px;
      background: rgba(79, 70, 229, 0.25);
      border: 1px solid rgba(99, 102, 241, 0.4);
    }

    @media (max-width: 640px) {
      .timeline-track,
      .timeline-progress {
        left: 12px;
        transform: none;
      }

      .timeline-dot {
        left: 12px;
        transform: translateX(-50%);
      }

      .timeline-card {
        margin-left: 28px;
      }
    }
  </style>
   </Layout>
