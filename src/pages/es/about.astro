---
import Layout from '../../layouts/Layout.astro';
import TimelineEntry from '../../components/TimelineEntry.astro';
import careerMilestones from '../../data/timeline_es.json';

// Define core values that shape professional approach (Spanish version)
const coreValues = [
  {
    title: "Excelencia Basada en Datos",
    description: "Comprometido con entregar soluciones respaldadas por análisis rigurosos y evidencia empírica, asegurando que las decisiones se fundamenten en hechos y no en suposiciones.",
    icon: "fa-chart-line"
  },
  {
    title: "Aprendizaje Continuo",
    description: "Dedicado a mantenerme a la vanguardia de los avances en ciencia de datos e inteligencia artificial mediante la autoeducación constante y oportunidades de aprendizaje formal.",
    icon: "fa-graduation-cap"
  },
  {
    title: "Defensor de la IA Ética",
    description: "Promuevo el desarrollo responsable de la inteligencia artificial, priorizando la equidad, la transparencia y el diseño centrado en el ser humano en todas las implementaciones técnicas.",
    icon: "fa-shield-alt"
  },
  {
    title: "Puente entre Negocio y Tecnología",
    description: "Capacidad para traducir conceptos técnicos complejos en valor comercial tangible y comunicarme eficazmente entre equipos técnicos y no técnicos.",
    icon: "fa-handshake"
  }
];

// Define areas of professional interest (Spanish version)
const researchInterests = [
  {
    area: "Aprendizaje Automático Geoespacial",
    examples: ["Algoritmos de inteligencia de ubicación", "Reconocimiento de patrones geográficos", "Modelos de predicción espacial"],
    color: "indigo"
  },
  {
    area: "Sistemas de IA Multimodales",
    examples: ["Modelos de visión y lenguaje", "Recuperación de información cruzada (cross-modal)", "Embeddings multimodales"],
    color: "pink"
  },
  {
    area: "IA Responsable",
    examples: ["Equidad en aprendizaje automático", "Métodos de IA explicable (XAI)", "Ética en ciencia de datos"],
    color: "purple"
  },
  {
    area: "Inteligencia de Negocios",
    examples: ["Sistemas estratégicos de soporte a decisiones", "Analítica predictiva", "Visualización interactiva de datos"],
    color: "blue"
  }
];

// Define professional approach methodology (Spanish version)
const methodology = [
  {
    phase: "Descubrimiento",
    description: "Comprensión profunda del contexto empresarial, las necesidades de los interesados y el panorama de datos existente a través de la exploración colaborativa.",
    steps: ["Entrevistas con partes interesadas", "Inventario de datos", "Formulación del problema", "Identificación de oportunidades"]
  },
  {
    phase: "Diseño de Soluciones",
    description: "Enfoque sistemático para la arquitectura y selección de algoritmos basado en los requisitos del problema, restricciones de datos y objetivos comerciales.",
    steps: ["Planificación de arquitectura", "Selección de métodos", "Diseño de prototipos", "Validación de viabilidad"]
  },
  {
    phase: "Implementación",
    description: "Desarrollo iterativo con pruebas y refinamientos continuos para garantizar que las soluciones cumplan con los requisitos tanto técnicos como comerciales.",
    steps: ["Construcción de pipelines de datos", "Desarrollo de modelos", "Pruebas de validación", "Optimización del rendimiento"]
  },
  {
    phase: "Integración",
    description: "Despliegue fluido y transferencia de conocimiento que garantizan que las soluciones generen valor comercial sostenible con un impacto medible.",
    steps: ["Documentación", "Capacitación de interesados", "Integración de sistemas", "Medición de impacto"]
  }
];

// Define SEO metadata in Spanish
const title = "Sobre Mí | Gairo Peralta - Ingeniero de AI/ML";
const description = "Conoce la trayectoria de Gairo Peralta, su camino profesional y su enfoque para construir sistemas LLM, plataformas GeoAI y pipelines de ML en producción.";

// Structured data for SEO (Spanish version)
const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": title,
  "description": description,
  "about": {
    "@type": "Person",
    "name": "Gairo Peralta",
    "alternateName": [
      "Gairo Yostin Peralta",
      "Gairo Yostin Peralta Alvarez",
      "Gairo Y. Peralta"
    ],
    "jobTitle": "Ingeniero de AI/ML",
    "alumniOf": [
      {
        "@type": "EducationalOrganization",
        "name": "Universidad de California, Berkeley",
        "sameAs": "https://berkeley.edu"
      },
      {
        "@type": "EducationalOrganization",
        "name": "Tecnológico de Monterrey",
        "sameAs": "https://tec.mx"
      }
    ],
    "knowsAbout": [
      "Ciencia de Datos",
      "Aprendizaje Automático",
      "Inteligencia Artificial",
      "Análisis Geoespacial",
      "Inteligencia de Negocios"
    ],
    "seeks": researchInterests.map(r => r.area)
  },
  "mainContentOfPage": {
    "@type": "WebPageElement",
    "cssSelector": ".main-content"
  }
};
---

<Layout title={title} description={description} structuredData={structuredData}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 main-content">
    <!-- Hero Section -->
    <div class="mb-10 sm:mb-16">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl font-bold mb-4 sm:mb-6 text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-600">Sobre Mí</h1>
        <div class="w-32 sm:w-40 h-1 bg-gradient-to-r from-pink-500 to-indigo-600 mx-auto mb-6 sm:mb-8 rounded-full"></div>
        <p class="text-base sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Mi trayectoria como ingeniero de AI/ML está impulsada por la creación de sistemas LLM confiables y productos GeoAI que convierten datos complejos en impacto en el mundo real.
        </p>
      </div>
    </div>
    
    <!-- Personal & Professional Introduction -->
    <div class="grid md:grid-cols-3 gap-6 sm:gap-8 mb-12 sm:mb-20">
      <!-- Profile Image Column -->
      <div class="md:col-span-1">
        <div class="relative mb-6">
          <div class="absolute inset-0 bg-gradient-to-br from-pink-500 to-indigo-600 rounded-xl blur-xl opacity-20 transform -rotate-6"></div>
          <img 
            src="/images/profile.jpg" 
            alt="Gairo Peralta - Ingeniero de AI/ML" 
            class="relative rounded-xl w-full h-auto shadow-xl"
          />
          
          <!-- Contact Info Card -->
          <div class="bg-gray-800/70 rounded-xl p-4 sm:p-6 mt-6 border border-gray-700 backdrop-blur-sm">
            <h3 class="text-lg font-semibold text-white mb-3 sm:mb-4">Conéctate Conmigo</h3>
            
            <div class="space-y-3 sm:space-y-4">
              <a href="https://linkedin.com/in/gairoperalta" target="_blank" rel="noopener noreferrer" class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
                <i class="fab fa-linkedin text-xl w-8"></i>
                <span>LinkedIn</span>
              </a>
              
              <a href="https://github.com/gairoperalta" target="_blank" rel="noopener noreferrer" class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
                <i class="fab fa-github text-xl w-8"></i>
                <span>GitHub</span>
              </a>
              
              <a href="mailto:gairo@berkeley.edu" class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
                <i class="fas fa-envelope text-xl w-8"></i>
                <span>Correo Electrónico</span>
              </a>
              
              <a href="/es/contact" class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
                <i class="fas fa-paper-plane text-xl w-8"></i>
                <span>Formulario de Contacto</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Bio Information Column -->
      <div class="md:col-span-2">
        <div class="prose prose-lg prose-invert max-w-none">
          <h2 class="text-2xl sm:text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-500 mb-4 sm:mb-6">Mi Trayectoria Profesional</h2>
          
          <p class="mb-4 text-base sm:text-lg">
            Soy un ingeniero de AI/ML especializado en sistemas LLM, GeoAI y pipelines de ML en producción. Me enfoco en entregar soluciones que transforman datos complejos en inteligencia accionable para mejores decisiones de negocio.
          </p>
          
          <p class="mb-4 text-base sm:text-lg italic text-gray-400">
            Conocido profesionalmente como <strong>Gairo Peralta</strong>, mi nombre legal completo es <strong>Gairo Yostin Peralta Alvarez</strong> en México y <strong>Gairo Yostin Peralta</strong> en los Estados Unidos.
          </p>
          
          <p class="mb-4 text-base sm:text-lg">
            Mi experiencia abarca sectores como el legal, el inmobiliario y la analítica empresarial. Construyo sistemas que combinan el razonamiento de LLMs, grafos de conocimiento y pipelines de datos escalables para ofrecer resultados tangibles y medibles.
          </p>
          
          <p class="mb-4 text-base sm:text-lg">
            Actualmente curso una Maestría en Inteligencia Artificial Aplicada en el Tecnológico de Monterrey, mientras contribuyo a la investigación de IA médica en UT San Antonio como estudiante de investigación visitante.
          </p>
          
          <p class="text-base sm:text-lg">
            Mi enfoque combina profundidad técnica con mentalidad de producto. Priorizo la confiabilidad, la seguridad y el retorno de inversión (ROI) medible al desplegar sistemas de IA en entornos de producción.
          </p>
          
          <div class="mt-6 sm:mt-8 flex flex-wrap gap-3 sm:items-center sm:justify-start">
            <a href="/es/resume" class="inline-flex items-center bg-gradient-to-r from-indigo-600 to-indigo-800 hover:from-indigo-700 hover:to-indigo-900 text-white font-semibold py-2 sm:py-3 px-4 sm:px-6 rounded-lg shadow-md transition duration-300 ease-in-out text-sm sm:text-base touch-manipulation micro-cta">
              <i class="fas fa-file-alt mr-2"></i>
              Ver Currículum
            </a>
            <a href="/es/experience" class="inline-flex items-center bg-gray-700 hover:bg-gray-600 text-white font-semibold py-2 sm:py-3 px-4 sm:px-6 rounded-lg shadow-md transition duration-300 ease-in-out text-sm sm:text-base touch-manipulation micro-cta">
              <i class="fas fa-project-diagram mr-2"></i>
              Ver Proyectos
            </a>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Career Timeline -->
    <div class="mb-12 sm:mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-500 mb-8 sm:mb-12">Línea del Tiempo Profesional</h2>
      
      <div class="timeline-wrap relative" data-timeline>
        <div class="timeline-track" aria-hidden="true"></div>
        <div class="timeline-progress" data-timeline-progress aria-hidden="true"></div>
        
        <div class="space-y-10 sm:space-y-16">
          {careerMilestones.map((milestone, index) => (
            <TimelineEntry milestone={milestone} index={index} />
          ))}
        </div>
      </div>
    </div>
    
    <!-- Core Values Section -->
    <div class="mb-12 sm:mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-500 mb-8 sm:mb-12">Valores Profesionales</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-8">
        {coreValues.map(value => (
          <div class="bg-gray-800/50 border border-gray-700 hover:border-indigo-700/50 p-4 sm:p-6 rounded-xl shadow-lg transition-all duration-300 transform hover:scale-105 touch-manipulation" data-reveal>
            <div class="flex items-start">
              <div class="bg-gradient-to-br from-pink-500 to-indigo-600 w-10 h-10 sm:w-14 sm:h-14 rounded-xl flex items-center justify-center flex-shrink-0 mr-4">
                <i class={`fas ${value.icon} text-xl sm:text-2xl text-white`}></i>
              </div>
              <div>
                <h3 class="text-lg sm:text-xl font-semibold text-white mb-2">{value.title}</h3>
                <p class="text-sm sm:text-base text-gray-300">{value.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Research Interests Section -->
    <div class="mb-12 sm:mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-500 mb-8 sm:mb-12">Áreas de Interés Profesional</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-8">
        {researchInterests.map(interest => (
          <div class={`bg-${interest.color}-900/20 border border-${interest.color}-800/30 p-4 sm:p-6 rounded-xl shadow-lg`} data-reveal>
            <h3 class={`text-lg sm:text-xl font-semibold text-${interest.color}-400 mb-3 sm:mb-4`}>{interest.area}</h3>
            <ul class="space-y-1 sm:space-y-2">
              {interest.examples.map(example => (
                <li class="flex items-start">
                  <span class={`text-${interest.color}-500 mr-2`}>›</span>
                  <span class="text-sm sm:text-base text-gray-300">{example}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Methodology Section -->
    <div class="mb-12 sm:mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-500 mb-8 sm:mb-12">Mi Enfoque Profesional</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {methodology.map((phase, index) => (
          <div class="bg-gray-800/50 border border-gray-700 p-4 sm:p-6 rounded-xl shadow-lg" data-reveal>
            <div class="bg-gradient-to-br from-pink-500 to-indigo-600 w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center mb-3 sm:mb-4 text-lg sm:text-xl font-bold text-white">
              {index + 1}
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white mb-2 sm:mb-3">{phase.phase}</h3>
            <p class="text-xs sm:text-sm text-gray-300 mb-3 sm:mb-4">{phase.description}</p>
            <ul class="space-y-1 text-xs sm:text-sm">
              {phase.steps.map(step => (
                <li class="flex items-start">
                  <span class="text-indigo-400 mr-2">•</span>
                  <span class="text-gray-400">{step}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Call to Action Section -->
    <div class="text-center">
      <div class="bg-gradient-to-r from-gray-800/70 to-gray-900/70 rounded-xl p-6 sm:p-8 shadow-lg backdrop-blur-sm border border-gray-800/50 max-w-4xl mx-auto" data-reveal>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 sm:mb-4">¿Te interesa que colaboremos?</h2>
        <p class="text-sm sm:text-base text-gray-300 mb-4 sm:mb-6 max-w-2xl mx-auto">
          Siempre estoy abierto a discutir nuevos proyectos, ideas creativas o a formar parte de tu visión técnica. Conectémonos para explorar cómo podemos crear soluciones de datos robustas juntos.
        </p>
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4">
          <a href="/es/contact" class="bg-gradient-to-r from-pink-500 to-pink-700 hover:from-pink-600 hover:to-pink-800 text-white font-semibold py-2 sm:py-3 px-4 sm:px-8 rounded-lg shadow-md transition duration-300 ease-in-out text-sm sm:text-base touch-manipulation micro-cta">
            Iniciar una Conversación
          </a>
          <a href="/es/experience" class="bg-gradient-to-r from-indigo-600 to-indigo-800 hover:from-indigo-700 hover:to-indigo-900 text-white font-semibold py-2 sm:py-3 px-4 sm:px-8 rounded-lg shadow-md transition duration-300 ease-in-out text-sm sm:text-base touch-manipulation micro-cta">
            Ver mis Proyectos
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
