---
import Layout from '../../layouts/Layout.astro';

// Define services offered for collaboration
const services = [
  {
    title: "Consultoría de Ciencia de Datos",
    description: "Orientación experta sobre estrategia de datos, arquitectura analítica e implementación de sistemas de decisión basados en datos.",
    icon: "fa-chart-bar",
    examples: ["Evaluación de madurez de datos", "Desarrollo de ruta analítica", "Consultoría en estrategia de datos"]
  },
  {
    title: "Soluciones de IA Personalizadas",
    description: "Desarrollo de modelos de aprendizaje automático a medida y aplicaciones de IA para abordar desafíos comerciales específicos.",
    icon: "fa-robot",
    examples: ["Sistemas de analítica predictiva", "Motores de recomendación personalizados", "Aplicaciones de visión computacional"]
  },
  {
    title: "Analítica Geoespacial",
    description: "Soluciones de inteligencia basada en ubicación que combinan capacidades de SIG con analítica avanzada para la toma de decisiones estratégicas.",
    icon: "fa-map-marked-alt",
    examples: ["Mapeo de potencial de mercado", "Optimización de ubicación", "Análisis de patrones geoespaciales"]
  },
  {
    title: "Visualización de Datos",
    description: "Creación de dashboards interactivos y herramientas de analítica visual que hacen que los datos complejos sean accesibles y accionables.",
    icon: "fa-chart-line",
    examples: ["Dashboards ejecutivos", "Visualizaciones interactivas", "Sistemas de reportes automatizados"]
  }
];

// Define collaboration types
const collaborationTypes = [
  {
    type: "Trabajo Basado en Proyectos",
    description: "Compromiso de alcance definido con entregables, cronograma y objetivos claros. Ideal para desafíos comerciales específicos que requieren experiencia en ciencia de datos.",
    suitable: ["Empresas que necesitan soluciones de IA especializadas", "Startups con proyectos de datos definidos", "Organizaciones que requieren pruebas de concepto"]
  },
  {
    type: "Asesoría y Consultoría",
    description: "Orientación estratégica y asesoramiento técnico sobre la implementación de ciencia de datos, selección de tecnología y mejores prácticas.",
    suitable: ["Equipos de liderazgo que planean iniciativas de datos", "Organizaciones que construyen capacidades internas de datos", "Equipos que navegan decisiones de datos complejas"]
  },
  {
    type: "Colaboración en Investigación",
    description: "Asociación en proyectos de investigación innovadores que exploran nuevas metodologías en aprendizaje automático, IA o ciencia de datos aplicada.",
    suitable: ["Instituciones académicas", "Organizaciones orientadas a la investigación", "Laboratorios de innovación y departamentos de I+D"]
  },
  {
    type: "Talleres y Capacitación",
    description: "Sesiones de transferencia de conocimiento y capacitación práctica para equipos que buscan desarrollar capacidades internas de ciencia de datos.",
    suitable: ["Equipos de datos que expanden sus habilidades", "Organizaciones en transición hacia una cultura basada en datos", "Equipos técnicos que adoptan nuevas tecnologías de datos"]
  }
];

// Define contact information
const contactInfo = {
  email: "gairo@berkeley.edu",
  linkedin: "https://linkedin.com/in/gairoperalta",
  github: "https://github.com/Gerion9",
  response_time: "24 a 48 horas"
};

// Define SEO metadata
const title = "Contacto y Colaboración | Gairo Peralta - Ingeniero de IA/ML";
const description = "Ponte en contacto para discutir sistemas LLM, plataformas de GeoAI y pipelines de ML en producción. Transformemos tus desafíos de datos en ventajas estratégicas.";

// Structured data for SEO (localised)
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": title,
  "description": description,
  "about": {
    "@type": "Person",
    "name": "Gairo Peralta",
    "jobTitle": "Ingeniero de IA/ML",
    "email": contactInfo.email,
    "sameAs": [
      contactInfo.linkedin,
      contactInfo.github
    ],
    "makesOffer": services.map(service => ({
      "@type": "Offer",
      "name": service.title,
      "description": service.description
    }))
  }
};
---

<Layout title={title} description={description} structuredData={structuredData}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12 main-content">
    <!-- Hero Section -->
    <div class="mb-8 sm:mb-16" data-reveal>
      <div class="text-center">
        <h1 class="text-3xl sm:text-5xl font-bold mb-4 sm:mb-6 text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-600">Conectemos</h1>
        <div class="w-32 sm:w-40 h-1 bg-gradient-to-r from-pink-500 to-indigo-600 mx-auto mb-4 sm:mb-8 rounded-full"></div>
        <p class="text-base sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
          ¿Listo para explorar cómo la ciencia de datos y la IA pueden transformar tus desafíos comerciales en oportunidades? Iniciemos una conversación sobre tus objetivos y cómo podemos alcanzarlos juntos.
        </p>
      </div>
    </div>
    
    <!-- Two Column Layout: Contact Form and Info -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-8 mb-12 sm:mb-20" data-reveal>
      <!-- Contact Form -->
      <div class="lg:col-span-2 bg-gray-800/50 rounded-xl p-4 sm:p-8 border border-gray-700 shadow-lg card-hover">
        <h2 class="text-xl sm:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-500 mb-4 sm:mb-6">Enviar un Mensaje</h2>
        
        <form id="contact-form" class="space-y-4 sm:space-y-6" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <!-- Netlify Form Configuration -->
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="subject" value="Nuevo mensaje desde gairoperalta.com" />
          <p class="hidden">
            <label>No llenar esto si eres humano: <input name="bot-field" /></label>
          </p>
          
          <!-- Name Field -->
          <div>
            <label for="name" class="block text-sm font-medium text-gray-300 mb-1">Nombre</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              class="w-full px-3 sm:px-4 py-2 bg-gray-700/50 border border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-white text-sm sm:text-base"
              placeholder="Tu nombre"
            />
          </div>
          
          <!-- Email Field -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Correo Electrónico</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              class="w-full px-3 sm:px-4 py-2 bg-gray-700/50 border border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-white text-sm sm:text-base"
              placeholder="tu.correo@ejemplo.com"
            />
          </div>
          
          <!-- Subject Field -->
          <div>
            <label for="subject-field" class="block text-sm font-medium text-gray-300 mb-1">Asunto</label>
            <input 
              type="text" 
              id="subject-field" 
              name="subject-field" 
              required 
              class="w-full px-3 sm:px-4 py-2 bg-gray-700/50 border border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-white text-sm sm:text-base"
              placeholder="¿De qué trata tu consulta?"
            />
          </div>
          
          <!-- Collaboration Type Field -->
          <div>
            <label for="collaboration_type" class="block text-sm font-medium text-gray-300 mb-1">Tipo de Colaboración</label>
            <select 
              id="collaboration_type" 
              name="collaboration_type" 
              class="w-full px-3 sm:px-4 py-2 bg-gray-700/50 border border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-white text-sm sm:text-base"
            >
              <option value="">Selecciona un tipo de colaboración</option>
              <option value="Project-Based Work">Trabajo Basado en Proyectos</option>
              <option value="Advisory & Consulting">Asesoría y Consultoría</option>
              <option value="Research Collaboration">Colaboración en Investigación</option>
              <option value="Workshops & Training">Talleres y Capacitación</option>
              <option value="Other">Otro</option>
            </select>
          </div>
          
          <!-- Message Field -->
          <div>
            <label for="message" class="block text-sm font-medium text-gray-300 mb-1">Mensaje</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              required 
              class="w-full px-3 sm:px-4 py-2 bg-gray-700/50 border border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-white resize-none text-sm sm:text-base"
              placeholder="Cuéntame sobre tu proyecto o consulta..."
            ></textarea>
          </div>
          
          <!-- Submit Button -->
          <div>
            <button 
              type="submit"
              class="w-full bg-gradient-to-r from-pink-500 to-indigo-600 hover:from-pink-600 hover:to-indigo-700 text-white font-semibold py-2.5 sm:py-3 px-4 sm:px-6 rounded-lg shadow-md transition-all duration-300 touch-manipulation micro-cta"
            >
              Enviar Mensaje
            </button>
          </div>
          
          <p class="text-xs sm:text-sm text-gray-400 text-center">
            Responderé a tu mensaje en un plazo de {contactInfo.response_time}.
          </p>
        </form>
      </div>
      
      <!-- Contact Information -->
      <div class="lg:col-span-1 space-y-4 sm:space-y-8">
        <!-- Direct Contact Info -->
        <div class="bg-gray-800/50 rounded-xl p-4 sm:p-6 border border-gray-700 shadow-lg card-hover">
          <h3 class="text-lg sm:text-xl font-semibold text-white mb-3 sm:mb-4">Contacto Directo</h3>
          
          <div class="space-y-3 sm:space-y-4">
            <a href={`mailto:${contactInfo.email}`} class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
              <div class="bg-gradient-to-br from-pink-500 to-indigo-600 w-8 h-8 sm:w-10 sm:h-10 rounded-lg flex items-center justify-center flex-shrink-0 mr-3 sm:mr-4">
                <i class="fas fa-envelope text-white text-sm sm:text-base"></i>
              </div>
              <span class="text-sm sm:text-base">{contactInfo.email}</span>
            </a>
            
            <a href={contactInfo.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
              <div class="bg-gradient-to-br from-pink-500 to-indigo-600 w-8 h-8 sm:w-10 sm:h-10 rounded-lg flex items-center justify-center flex-shrink-0 mr-3 sm:mr-4">
                <i class="fab fa-linkedin-in text-white text-sm sm:text-base"></i>
              </div>
              <span class="text-sm sm:text-base">Perfil de LinkedIn</span>
            </a>
            
            <a href={contactInfo.github} target="_blank" rel="noopener noreferrer" class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
              <div class="bg-gradient-to-br from-pink-500 to-indigo-600 w-8 h-8 sm:w-10 sm:h-10 rounded-lg flex items-center justify-center flex-shrink-0 mr-3 sm:mr-4">
                <i class="fab fa-github text-white text-sm sm:text-base"></i>
              </div>
              <span class="text-sm sm:text-base">Perfil de GitHub</span>
            </a>
          </div>
        </div>
        
        <!-- Quick Links -->
        <div class="bg-gray-800/50 rounded-xl p-4 sm:p-6 border border-gray-700 shadow-lg card-hover">
          <h3 class="text-lg sm:text-xl font-semibold text-white mb-3 sm:mb-4">Enlaces Rápidos</h3>
          
          <div class="space-y-2 sm:space-y-3">
            <a href="/es/resume" class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
              <i class="fas fa-file-alt w-6 text-indigo-400"></i>
              <span class="text-sm sm:text-base">Currículum Profesional</span>
            </a>
            
            <a href="/es/experience" class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
              <i class="fas fa-project-diagram w-6 text-indigo-400"></i>
              <span class="text-sm sm:text-base">Portafolio de Proyectos</span>
            </a>
            
            <a href="/es/about" class="flex items-center text-gray-300 hover:text-indigo-400 transition-colors duration-300 touch-manipulation">
              <i class="fas fa-user w-6 text-indigo-400"></i>
              <span class="text-sm sm:text-base">Sobre Mí</span>
            </a>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Services Grid -->
    <div class="mb-12 sm:mb-20" data-reveal>
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-500 mb-6 sm:mb-12">Servicios y Especialidades</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-8">
        {services.map(service => (
          <div class="bg-gray-800/50 rounded-xl p-4 sm:p-6 border border-gray-700 hover:border-indigo-500/30 transition-all duration-300 transform hover:scale-105 shadow-lg touch-manipulation card-hover" data-reveal>
            <div class="flex items-start">
              <div class="bg-gradient-to-br from-pink-500 to-indigo-600 w-10 sm:w-14 h-10 sm:h-14 rounded-xl flex items-center justify-center flex-shrink-0 mr-3 sm:mr-4">
                <i class={`fas ${service.icon} text-xl sm:text-2xl text-white`}></i>
              </div>
              <div>
                <h3 class="text-lg sm:text-xl font-semibold text-white mb-1 sm:mb-2">{service.title}</h3>
                <p class="text-gray-300 mb-3 sm:mb-4 text-sm sm:text-base">{service.description}</p>
                
                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                  {service.examples.map(example => (
                    <span class="text-xs bg-gray-700/70 text-gray-300 px-2 sm:px-3 py-0.5 sm:py-1 rounded-full">{example}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Collaboration Types -->
    <div class="mb-12 sm:mb-20" data-reveal>
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-indigo-500 mb-6 sm:mb-12">Oportunidades de Colaboración</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-8">
        {collaborationTypes.map(collab => (
          <div class="bg-gray-800/50 rounded-xl p-4 sm:p-6 border border-gray-700 shadow-lg card-hover" data-reveal>
            <h3 class="text-lg sm:text-xl font-semibold text-white mb-2 sm:mb-3">{collab.type}</h3>
            <p class="text-gray-300 mb-3 sm:mb-4 text-sm sm:text-base">{collab.description}</p>
            
            <h4 class="text-xs sm:text-sm font-medium text-indigo-400 mb-1.5 sm:mb-2">Ideal para:</h4>
            <ul class="space-y-1">
              {collab.suitable.map(item => (
                <li class="flex items-start text-gray-300 text-xs sm:text-sm">
                  <span class="text-pink-500 mr-2">›</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    
    <!-- CTA Section -->
    <div class="text-center" data-reveal>
      <div class="bg-gradient-to-r from-gray-800/70 to-gray-900/70 rounded-xl p-4 sm:p-8 shadow-lg backdrop-blur-sm border border-gray-800/50 max-w-4xl mx-auto card-hover">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 sm:mb-4">¿Listo para Transformar tus Desafíos de Datos?</h2>
        <p class="text-gray-300 mb-4 sm:mb-6 max-w-2xl mx-auto text-sm sm:text-base">
          Ya sea que estés comenzando tu viaje en el mundo de los datos o busques mejorar tus capacidades existentes, estoy aquí para ayudarte a aprovechar todo el potencial de tus activos de datos.
        </p>
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4">
          <a href="#contact-form" class="bg-gradient-to-r from-pink-500 to-pink-700 hover:from-pink-600 hover:to-pink-800 text-white font-semibold py-2 sm:py-3 px-4 sm:px-8 rounded-lg shadow-md transition duration-300 ease-in-out text-sm sm:text-base touch-manipulation micro-cta">
            Enviar un Mensaje
          </a>
          <a href="/es/experience" class="bg-gradient-to-r from-indigo-600 to-indigo-800 hover:from-indigo-700 hover:to-indigo-900 text-white font-semibold py-2 sm:py-3 px-4 sm:px-8 rounded-lg shadow-md transition duration-300 ease-in-out text-sm sm:text-base touch-manipulation micro-cta">
            Explorar Proyectos
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <style>
    /* Improved touch target for mobile */
    .touch-manipulation {
      touch-action: manipulation;
    }
    
    /* Mobile-specific adjustments */
    @media (max-width: 640px) {
      input, select, textarea, button {
        font-size: 16px; /* Prevents iOS zoom on focus */
      }
      
      textarea {
        max-height: 150px;
      }
    }
  </style>
</Layout>
