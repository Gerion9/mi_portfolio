---
import Icon from '../Icon.astro';
import SplitWords from '../SplitWords.astro';
import ProjectCover from '../ProjectCover.astro';
import { fmt, localizePath, useCopy, type Lang } from '../../i18n';
import { getProjectBySlug, getProjects, type Project } from '../../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useCopy(lang).home.work;
const total = getProjects(lang).length;

// Featured by slug: titles come from the data (they honor SHOW_CLIENT_NAMES)
const featured = t.featured
  .map((f) => ({ copy: f, project: getProjectBySlug(lang, f.slug) }))
  .filter((f): f is { copy: (typeof t.featured)[number]; project: Project } => Boolean(f.project));

// Only figures make good chips ("<60s" yes, "Century Schoolbook" no)
const numeric = (p: Project) => p.metrics.filter((m) => /\d/.test(m.value));

const layout = ['lg:col-span-7', 'lg:col-span-5', 'lg:col-span-4', 'lg:col-span-4', 'lg:col-span-4'];
const coverHeight = ['aspect-[16/9]', 'aspect-[16/9] lg:aspect-[4/3.05]', 'aspect-[16/10]', 'aspect-[16/10]', 'aspect-[16/10]'];
---

<section class="section cv-section" style="--cis: 114rem; --cis-sm: 214rem" aria-labelledby="work-title">
  <div class="container-site">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow reveal">{t.eyebrow}</p>
        <SplitWords as="h2" id="work-title" text={t.title} class="section-title mt-5" />
        <p class="lede reveal mt-5" style="--d: 100">{t.intro}</p>
      </div>
      <a href={localizePath('/experience', lang)} class="btn btn-secondary reveal shrink-0 self-start lg:self-auto">
        {fmt(t.viewAll, { count: total })}
        <Icon name="arrow-right" class="btn-arrow h-4 w-4" />
      </a>
    </div>

    <div class="mt-14 grid gap-4 sm:gap-5 lg:grid-cols-12">
      {
        featured.map(({ copy, project }, i) => (
          <article
            class:list={['work-card surface spotlight reveal group relative flex flex-col overflow-hidden', layout[i]]}
            data-case-root
            style={`--d: ${(i % 3) * 80}`}
          >
            <div class:list={['relative overflow-hidden border-b border-line', coverHeight[i]]} data-cover>
              <ProjectCover
                slug={project.slug}
                domain={project.primary}
                variant={project.cover}
                uid={`feat-${i}`}
                class="h-full w-full transition-transform duration-[1.2s] ease-out-expo group-hover:scale-[1.04]"
              />
              <div class="absolute left-4 top-4 flex flex-wrap gap-2">
                <span class="tag border-fg/15 bg-ink/60 text-fg backdrop-blur">{project.year}</span>
              </div>
            </div>
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-fg-subtle">{project.company}</p>
              <h3 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-fg [overflow-wrap:anywhere]">
                <a href={localizePath(`/experience/${project.slug}`, lang)} class="work-card__link" data-case>
                  {project.shortTitle}<span class="sr-only">, {t.readCase}</span>
                </a>
              </h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-fg-muted">{copy.outcome}</p>
              {numeric(project).length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-2">
                  {numeric(project).slice(0, 2).map((m) => (
                    <li class="rounded-xl border border-line bg-fg/[0.03] px-3 py-2">
                      <span class="block text-sm font-semibold text-fg">{m.value}</span>
                      {m.label && <span class="mt-0.5 block font-mono text-[0.625rem] uppercase tracking-[0.1em] text-fg-subtle">{m.label}</span>}
                    </li>
                  ))}
                </ul>
              )}
              <span class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-medium text-fg" aria-hidden="true">
                {t.readCase}
                <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-500 ease-out-expo group-hover:translate-x-1" />
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Whole card is clickable through the title link (one tab stop per card) */
  .work-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .work-card__link:focus-visible {
    outline: none;
  }

  .work-card:has(.work-card__link:focus-visible) {
    outline: 2px solid #c4b5fd;
    outline-offset: 3px;
  }
</style>
