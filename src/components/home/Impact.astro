---
import SplitWords from '../SplitWords.astro';
import { useCopy, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useCopy(lang).home.impact;

// "+24.2pp" -> prefix "+", number 24.2, suffix "pp" (number is animated)
const parse = (value: string) => {
  const m = value.match(/^([^\d]*)([\d.,]+)(.*)$/);
  if (!m) return { prefix: '', number: null as number | null, decimals: 0, suffix: value };
  const raw = m[2].replace(/,/g, '');
  return {
    prefix: m[1].trim(),
    number: parseFloat(raw),
    decimals: raw.includes('.') ? raw.split('.')[1].length : 0,
    suffix: m[3].trim(),
  };
};

const items = t.items.map((item) => ({ ...item, parsed: parse(item.value) }));
const accents = ['var(--teal)', 'var(--violet)', 'var(--pink)', 'var(--amber)'];
---

<section id="impact" class="section scroll-mt-24" aria-labelledby="impact-title">
  <div class="container-site">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow reveal">{t.eyebrow}</p>
        <SplitWords as="h2" id="impact-title" text={t.title} class="section-title mt-5" />
      </div>
    </div>

    <dl class="reveal mt-14 grid gap-px overflow-hidden rounded-[1.75rem] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item, i) => (
          <div
            class="spotlight relative flex min-h-[15rem] flex-col justify-between bg-ink-2 p-7 sm:min-h-[17rem] sm:p-8"
            style={`--spot: ${accents[i % accents.length]}`}
          >
            <dt class="order-2 mt-10">
              <span class="block text-[0.9375rem] leading-snug text-fg">{item.label}</span>
              <span class="mt-3 block font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-fg-subtle">
                {item.context}
              </span>
            </dt>
            <dd class="order-1 flex items-baseline text-[clamp(2.75rem,5vw,4.25rem)] font-semibold leading-none tracking-[-0.05em] text-fg">
              <span class="sr-only">{item.value}</span>
              <span class="tabular" aria-hidden="true">{item.parsed.prefix}{item.parsed.number !== null ? (<span data-count={item.parsed.number} data-decimals={item.parsed.decimals}>{item.parsed.number.toFixed(item.parsed.decimals)}</span>) : null}</span>
              <span class="ml-1 text-[0.55em] font-medium tracking-[-0.02em]" style={`color: rgb(${accents[i % accents.length]})`} aria-hidden="true">
                {item.parsed.suffix}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
