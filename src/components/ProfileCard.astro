---
/**
 * Holographic profile card (after React Bits' ProfileCard / TiltedCard):
 * 3D tilt on a spring, a glare and an iridescent sheen that follow the pointer.
 * Pointer position arrives as --gx / --gy from interactions.ts ([data-tilt]).
 */
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  class?: string;
  /** Caption on the glass plate (defaults to name + current title). */
  title?: string;
  subtitle?: string;
  sizes?: string;
  /** For copies hidden at some breakpoints: lazy images cost nothing while hidden. */
  lazy?: boolean;
  /** Only fetch the portrait when this media query matches (e.g. the card is hidden on phones). */
  media?: string;
  /** Hex badge beside the caption (off for narrow cards). */
  badge?: boolean;
}

// 1×1 transparent placeholder for viewports where the card isn't shown
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

const {
  lang,
  class: className,
  title = 'Gairo Peralta',
  subtitle = lang === 'es' ? 'Ingeniero líder de IA' : 'Lead AI Engineer',
  sizes = '(min-width: 1024px) 380px, 80vw',
  lazy = false,
  media,
  badge = true,
} = Astro.props;
const gate = media ? { media } : {};
---

<div class:list={['profile-card', className]} data-tilt="7">
  <div class="profile-card__frame">
    <picture>
      <source type="image/avif" srcset="/images/profile-portrait-960.avif 960w" sizes={sizes} {...gate} />
      <source type="image/webp" srcset="/images/profile-portrait-480.webp 480w, /images/profile-portrait-960.webp 960w" sizes={sizes} {...gate} />
      <img
        src={media ? BLANK : '/images/profile-portrait-480.webp'}
        width="480"
        height="600"
        alt={lang === 'es' ? 'Retrato de Gairo Peralta' : 'Portrait of Gairo Peralta'}
        class="profile-card__img"
        loading={lazy ? 'lazy' : 'eager'}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="profile-card__sheen" aria-hidden="true"></div>
    <div class="profile-card__glare" aria-hidden="true"></div>
    <div class="profile-card__meta">
      <div>
        <p class="text-lg font-semibold tracking-[-0.02em] text-white">{title}</p>
        <p class="mt-0.5 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-white/90">{subtitle}</p>
      </div>
      {badge && <span class="profile-card__badge" aria-hidden="true">
        <svg viewBox="0 0 32 32" class="h-5 w-5" fill="none">
          <path d="M16 2.6 27.6 9.3v13.4L16 29.4 4.4 22.7V9.3L16 2.6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
          <circle cx="16" cy="15.7" r="3" fill="currentColor"></circle>
        </svg>
      </span>}
    </div>
  </div>
</div>

<style>
  .profile-card {
    --gx: 50%;
    --gy: 30%;
    position: relative;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .profile-card__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 2rem;
    border: 1px solid rgb(var(--fg) / 0.14);
    background: rgb(var(--ink-3));
    box-shadow:
      0 40px 100px -40px rgb(var(--violet) / 0.55),
      0 30px 60px -30px rgb(0 0 0 / 0.9);
  }

  .profile-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.03);
  }

  /* Iridescent sheen, strongest where the light hits */
  .profile-card__sheen {
    position: absolute;
    inset: 0;
    background: conic-gradient(
      from 210deg at var(--gx) var(--gy),
      rgb(99 102 241 / 0.4),
      rgb(236 72 153 / 0.32),
      rgb(45 212 191 / 0.3),
      rgb(251 191 36 / 0.22),
      rgb(99 102 241 / 0.4)
    );
    mix-blend-mode: color-dodge;
    opacity: 0.18;
    transition: opacity 0.6s var(--ease-out);
  }

  .profile-card__glare {
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 55% at var(--gx) var(--gy), rgb(255 255 255 / 0.28), transparent 60%);
    mix-blend-mode: overlay;
    opacity: 0.5;
    transition: opacity 0.6s var(--ease-out);
  }

  .profile-card:hover .profile-card__sheen {
    opacity: 0.34;
  }

  .profile-card:hover .profile-card__glare {
    opacity: 0.85;
  }

  .profile-card__meta {
    position: absolute;
    inset: auto 0.75rem 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    background: rgb(10 10 16 / 0.62);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    transform: translateZ(40px);
  }

  .profile-card__badge {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: #f0abfc;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.16);
  }
</style>
