---
/** ML card visual: history line, forecast and its prediction interval. */
const W = 360;
const H = 190;
const r1 = (n: number) => Math.round(n * 10) / 10;

const hist: [number, number][] = [];
for (let i = 0; i <= 26; i++) {
  const x = 12 + i * 8.6;
  const y = 128 - i * 1.5 + Math.sin(i * 0.85) * 13 + Math.sin(i * 2.3) * 4;
  hist.push([x, y]);
}
const last = hist[hist.length - 1];
const fc: [number, number][] = [];
const up: [number, number][] = [];
const lo: [number, number][] = [];
for (let i = 0; i <= 12; i++) {
  const x = last[0] + i * 8.6;
  const y = last[1] - i * 1.5 + Math.sin((26 + i) * 0.85) * 13 - Math.sin(26 * 0.85) * 13;
  const spread = 3 + i * 2.9;
  fc.push([x, y]);
  up.push([x, y - spread]);
  lo.push([x, y + spread]);
}
const line = (p: [number, number][]) => p.map((q, i) => `${i ? 'L' : 'M'}${r1(q[0])} ${r1(q[1])}`).join('');
const band = `${line(up)}${[...lo]
  .reverse()
  .map((q) => `L${r1(q[0])} ${r1(q[1])}`)
  .join('')}Z`;
---

<div class="forecast reveal h-full w-full">
  <svg viewBox={`0 0 ${W} ${H}`} class="h-full w-full overflow-visible" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="fc-grad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fbbf24"></stop>
        <stop offset="1" stop-color="#f24968"></stop>
      </linearGradient>
      <linearGradient id="fc-area" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fbbf24" stop-opacity=".18"></stop>
        <stop offset="1" stop-color="#fbbf24" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    {[40, 80, 120, 160].map((y) => <path d={`M0 ${y}H${W}`} stroke="#fff" stroke-opacity=".06" />)}
    <path class="fc-area" d={`${line(hist)}L${r1(last[0])} ${H}L12 ${H}Z`} fill="url(#fc-area)"></path>
    <path class="fc-band" d={band} fill="url(#fc-grad)" fill-opacity=".22"></path>
    <path d={`M${r1(last[0])} 10V${H}`} stroke="#fff" stroke-opacity=".22" stroke-dasharray="3 5"></path>
    <path class="fc-draw" d={line(hist)} pathLength="1" fill="none" stroke="#fff" stroke-opacity=".9" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"></path>
    <path class="fc-draw fc-draw--late" d={line(fc)} pathLength="1" fill="none" stroke="url(#fc-grad)" stroke-width="2" stroke-dasharray="0.02 0.018" stroke-linecap="round"></path>
    <circle class="fc-now" cx={r1(last[0])} cy={r1(last[1])} r="4.5" fill="#fff"></circle>
    <circle class="fc-pulse" cx={r1(last[0])} cy={r1(last[1])} r="4.5" fill="none" stroke="#fff" data-loop></circle>
    <text x={r1(last[0]) + 8} y="22" fill="#fff" fill-opacity=".5" font-size="10" font-family="Geist Mono Variable, monospace" letter-spacing="1">FORECAST</text>
  </svg>
</div>

<style>
  .fc-pulse {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    html.motion .forecast .fc-draw:not(.fc-draw--late) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    html.motion .forecast .fc-draw--late,
    html.motion .forecast .fc-band,
    html.motion .forecast .fc-now {
      opacity: 0;
    }

    html.motion .forecast.is-in .fc-draw:not(.fc-draw--late) {
      animation: fc-draw 1.6s var(--ease-out) 0.2s forwards;
    }

    html.motion .forecast.is-in .fc-draw--late,
    html.motion .forecast.is-in .fc-band,
    html.motion .forecast.is-in .fc-now {
      animation: fc-fade 0.9s var(--ease-out) 1.4s forwards;
    }

    html.motion .forecast.is-in .fc-pulse {
      animation: fc-pulse 2.4s var(--ease-out) 2.2s 4;
    }
  }

  @keyframes fc-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fc-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes fc-pulse {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(3.2);
    }
  }
</style>
