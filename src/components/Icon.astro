const resolved = alias[key] ?? key;
const isBrand = resolved in brand;
const body = isBrand ? brand[resolved] : stroke[resolved] ?? stroke.sparkles;
const role = label ? 'img' : undefined;
const hidden = label ? undefined : ('true' as const);
---

{
  isBrand ? (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="currentColor"
      focusable="false"
      role={role}
      aria-label={label}
      aria-hidden={hidden}
      set:html={body}
    />
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
      role={role}
      aria-label={label}
      aria-hidden={hidden}
      set:html={body}
    />
  )
}
